<odoo>
    <record id="pos_config_ir_cron" model="ir.cron">
        <field name="name">POS a.sign: Sign Missed</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_pos_config" />
        <field name="state">code</field>
        <field name="code">model._cron_asign_sign_missed()</field>
        <field name="priority" eval="5" />
    </record>
    <record id="pos_config_ir_cron_month_receipt" model="ir.cron">
        <field name="name">POS a.sign: Month Receipt</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_pos_config" />
        <field name="state">code</field>
        <field name="code">model._cron_asign_month_receipt()</field>
        <!-- Run just after midnight Vienna (23:05 UTC = 00:05 CET) so the receipt
             carries the counter of the month end. -->
        <field
            name="nextcall"
            eval="datetime.now().strftime('%Y-%m-%d 23:05:00')"
        />
        <field name="priority" eval="5" />
    </record>
</odoo>
