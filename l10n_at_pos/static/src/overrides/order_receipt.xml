<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_at_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-if="'asign_state' in props.data">
                <br/>
                <t t-if="props.data['asign_state'] == 'u'">
                    <b>The receipt could not be signed and is therefore not valid!</b>
                </t>
                <t t-elif="props.data['asign_state'] == 's'">
                    <br/><br/>
                    <img id="asign_qrcode" t-att-src="props.data.asign_qrcode_img" class="pos-receipt-qrcode"/>
                    <div class="pos-receipt-qrcode-text"><t t-esc="props.data['asign_ref']"/>: <t t-esc="props.data['asign_serial']"/></div>
                </t>
            </t>
        </xpath>
    </t>

</templates>
